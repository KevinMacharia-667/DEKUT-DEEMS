# Backend Configuration
HOST=127.0.0.1
PORT=8000

# Database Connection
# For local development with SQLite (no setup needed):
DATABASE_URL=sqlite:///./dekut_events.db

# For Supabase PostgreSQL (uncomment and fill in for production):
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
