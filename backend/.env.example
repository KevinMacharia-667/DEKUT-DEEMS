# Environment (Fails safe: defaults to "production" if omitted)
# In production, the backend REFUSES to boot with the default JWT_SECRET.
# To run locally with default secrets, explicitly set APP_ENV=development:
APP_ENV=development

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Database Connection
# For local development with SQLite (no setup needed):
DATABASE_URL=sqlite:///./dekut_events.db

# For hosted PostgreSQL in production (e.g. Neon; see docs/deployment.md):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# JWT Authentication
# In production (APP_ENV!=development), you MUST set a strong random secret.
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Auth Endpoint Rate Limiting (Brute-Force Protection)
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Behind a hosting proxy (e.g. Render), rate-limit by the real client IP
# AUTH_TRUST_PROXY=true

# Allowed frontend origins in production: comma-separated or a JSON list
# CORS_ORIGINS=https://tukio-web.onrender.com
